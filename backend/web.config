<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / Plesk (iisnode) hosting for RUN_MODE=single. Not used with PM2. See docs/deployment.md. -->
<configuration>
  <system.webServer>
    <!-- Let Node (Socket.IO) handle WebSockets instead of IIS. -->
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="dist/app/server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Let's Encrypt (Plesk) writes token files here; IIS must serve them directly. -->
        <rule name="acme" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <!-- Everything else goes to the app; nothing on disk (.env, sessions, source) is ever served. -->
        <rule name="app" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="dist/app/server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="storage" />
          <add segment="node_modules" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!--
      nodeProcessCountPerApplication=1: one WhatsApp connection per session (two would knock each other off).
      watchedFiles: only web.config restarts the app; session files written by Baileys must not.
    -->
    <iisnode
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config"
      gracefulShutdownTimeout="30000"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      loggingEnabled="true"
      logDirectory="iisnode-logs" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
