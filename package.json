{
  "name": "vengurla-messaging-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vengurla Tech WhatsApp Messaging Platform - API + worker",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/app/server.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx --test \"tests/unit/*.test.ts\"",
    "test:integration": "tsx --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "db:migrate": "npm --prefix ../database run migrate",
    "db:rollback": "npm --prefix ../database run rollback --",
    "db:seed": "npm --prefix ../database run seed"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "bullmq": "^6.3.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
