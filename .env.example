NODE_ENV=development
PORT=3000
# split  = API + worker processes with Redis/BullMQ (VPS, PM2)
# single = one process, SQL Server is the queue, no Redis needed (shared hosting / IIS)
RUN_MODE=split
LOG_LEVEL=info

# Microsoft SQL Server
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=vengurla_messaging
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true

# Redis (BullMQ queues + realtime fan-out between worker and API)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Dashboard auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Encrypts Meta access tokens and project webhook secrets at rest. Same generator as above.
# Changing it makes existing encrypted values unreadable.
ENCRYPTION_KEY=

# Baileys session storage (never public, never committed)
BAILEYS_AUTH_DIR=./storage/baileys/instances
BAILEYS_SEND_TIMEOUT_MS=30000

# Meta WhatsApp Cloud API
META_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Dashboard origin (CORS + Socket.IO)
FRONTEND_URL=http://localhost:5173

# Rate limits (per project, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REQUESTS_PER_WINDOW=300
RATE_LIMIT_MESSAGES_PER_WINDOW=60

# Queue behaviour
SEND_MAX_ATTEMPTS=5
WEBHOOK_MAX_ATTEMPTS=6
WORKER_CONCURRENCY=5
